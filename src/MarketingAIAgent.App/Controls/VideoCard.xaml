<UserControl x:Class="MarketingAIAgent.App.Controls.VideoCard" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><StackPanel><Image Source="{Binding Thumbnail}" Height="125" Stretch="UniformToFill"/><TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="0,8,0,3"/><TextBlock Text="{Binding Summary}" Foreground="#AFBCD5" FontSize="11"/><TextBlock Text="{Binding Url}" Foreground="#8EABFF" FontSize="10" TextTrimming="CharacterEllipsis"/></StackPanel></UserControl>
