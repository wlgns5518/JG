<Window x:Class="MarketingAIAgent.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:MarketingAIAgent.App.Controls" Title="Marketing AI Agent" Width="1510" Height="940" MinWidth="1100" MinHeight="740" WindowStartupLocation="CenterScreen">
 <DockPanel>
  <Border DockPanel.Dock="Top" Padding="24,17" BorderBrush="#293146" BorderThickness="0,0,0,1"><Grid><StackPanel><TextBlock Text="Marketing AI Agent" FontSize="25" FontWeight="Bold"/><TextBlock Text="DISCOVER  /  UNDERSTAND  /  CONNECT" Foreground="{StaticResource Accent}" FontSize="11"/></StackPanel><StackPanel HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock Text="{Binding DailyStatus}" Foreground="{StaticResource Muted}"/><TextBlock Text="운명원 · 검토 후 게시" HorizontalAlignment="Right"/></StackPanel></Grid></Border>
  <Border DockPanel.Dock="Bottom" Background="#1D263A" Padding="20,9"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Status}"/><ProgressBar Height="3" IsIndeterminate="{Binding IsBusy}" Foreground="{StaticResource Accent}" Background="#26334D"/></StackPanel><Button Grid.Column="1" Content="작업 취소" Command="{Binding CancelCommand}"/></Grid></Border>
  <TabControl TabStripPlacement="Left" Background="{StaticResource Bg}" BorderThickness="0" Foreground="White">
   <TabControl.Resources><Style TargetType="TabItem"><Setter Property="Foreground" Value="#A9B8D4"/><Setter Property="Padding" Value="18,16"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="Nav" Background="#161D2B" Padding="{TemplateBinding Padding}"><ContentPresenter ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Nav" Property="Background" Value="#304369"/><Setter Property="Foreground" Value="White"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></TabControl.Resources>
   <TabItem Header="◈  대시보드"><Grid Margin="10"><Grid.ColumnDefinitions><ColumnDefinition Width="1.05*" MinWidth="260"/><ColumnDefinition Width="5"/><ColumnDefinition Width="1.25*" MinWidth="290"/><ColumnDefinition Width="5"/><ColumnDefinition Width="1*" MinWidth="260"/></Grid.ColumnDefinitions>
    <Border Style="{StaticResource Card}"><DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="01  영상 탐색" Style="{StaticResource Heading}"/><TextBlock Text="검색어" Foreground="{StaticResource Muted}"/><TextBox Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanWork}"/><ComboBox SelectedIndex="{Binding SortIndex}" IsEnabled="{Binding CanWork}"><ComboBoxItem Content="최신순"/><ComboBoxItem Content="조회수순"/></ComboBox><Button Content="영상 불러오기" Command="{Binding SearchCommand}" Background="#405B9B"/><TextBlock Text="또는 YouTube URL로 바로 분석" Foreground="{StaticResource Muted}"/><TextBox Text="{Binding VideoUrl, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanWork}"/><Button Content="URL 불러오기 + AI 분석" Command="{Binding LoadUrlCommand}"/><Button Content="성장 후보 탐색 · 초안 전용" Command="{Binding FindGrowthCommand}"/><TextBlock Text="{Binding Growth}" FontSize="11" Foreground="{StaticResource Muted}"/></StackPanel><Button DockPanel.Dock="Bottom" Content="다음 페이지 불러오기" Command="{Binding MoreCommand}"/><ListBox ItemsSource="{Binding Videos}" SelectedItem="{Binding SelectedVideo}" IsEnabled="{Binding CanWork}"><ListBox.ItemTemplate><DataTemplate><controls:VideoCard/></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel></Border>
    <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#293146"/>
    <Border Grid.Column="2" Style="{StaticResource Card}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="02  맥락과 댓글" Style="{StaticResource Heading}"/><TextBlock Text="{Binding SelectedVideo.Title}" FontSize="16" FontWeight="SemiBold"/><Image Source="{Binding SelectedVideo.Thumbnail}" Height="150" Stretch="UniformToFill" Margin="0,8"/><Expander Header="영상 설명" Foreground="White"><TextBox Text="{Binding SelectedVideo.Description, Mode=OneWay}" IsReadOnly="True" MaxHeight="150" VerticalScrollBarVisibility="Auto"/></Expander><TextBlock Text="{Binding SourceNotice}" Foreground="#E5BE7A" FontSize="12"/><Button Content="AI 분석 시작 / 댓글 다시 생성" Command="{Binding AnalyzeCommand}"/><TextBlock Text="핵심 연애 고민" Foreground="{StaticResource Accent}"/><TextBlock Text="{Binding Concern}" FontSize="16"/><TextBlock Text="확인된 근거 구절 (제목·설명)" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding Evidence}"/><Expander Header="분석에 사용한 인기 댓글" Foreground="White"><TextBox Text="{Binding SourceComments, Mode=OneWay}" IsReadOnly="True" MaxHeight="160" VerticalScrollBarVisibility="Auto"/></Expander><TextBlock Text="댓글 편집 · 40~120자" Foreground="{StaticResource Accent}"/><TextBox Text="{Binding DraftText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="115" VerticalScrollBarVisibility="Auto" IsEnabled="{Binding CanWork}"/><TextBlock Text="{Binding CharacterCount, StringFormat='현재 {0}자'}" HorizontalAlignment="Right" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding Validation}" FontSize="11" Foreground="#E5BE7A"/><TextBlock Text="{Binding AnalysisModel}" FontSize="11" Foreground="{StaticResource Muted}"/><WrapPanel><Button Content="댓글 복사" Command="{Binding CopyCommand}"/><Button Content="초안 저장 · 게시 준비" Command="{Binding PrepareCommand}"/></WrapPanel></StackPanel></ScrollViewer></Border>
    <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch" Background="#293146"/>
    <Border Grid.Column="4" Style="{StaticResource Card}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="03  게시 관리" Style="{StaticResource Heading}"/><TextBlock Text="Chrome 프로필" Foreground="{StaticResource Muted}"/><ComboBox ItemsSource="{Binding Profiles}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedProfile}" IsEnabled="{Binding CanWork}"/><Button Content="Chrome 열기 · 로그인 확인" Command="{Binding LoginCommand}"/><TextBlock Text="{Binding AccountStatus}" Foreground="{StaticResource Accent}"/><TextBlock Text="최종 댓글 미리보기" Margin="0,18,0,6"/><Border Background="#101622" CornerRadius="8" Padding="14"><TextBlock Text="{Binding DraftText}"/></Border><TextBlock Text="실제 근거와 홍보 표기를 직접 확인하세요. 게시 직전에 영상·실제 로그인 계정·댓글을 다시 확인합니다." Foreground="{StaticResource Muted}" FontSize="12"/><CheckBox IsChecked="{Binding Approved}" IsEnabled="{Binding CanWork}" Content="댓글 검토 완료 · 게시 승인"/><Button Content="승인한 댓글 게시" Command="{Binding PublishCommand}" Background="#4266BA"/><TextBlock Text="{Binding Progress}" Foreground="{StaticResource Accent}"/><TextBlock Text="{Binding Blocked, StringFormat='이 영상의 재게시 차단: {0}'}" FontSize="11"/><TextBlock Text="최근 게시 기록" FontSize="16" Margin="0,20,0,8"/><ItemsControl ItemsSource="{Binding Posts}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#202839" CornerRadius="7" Margin="0,4" Padding="10"><StackPanel><TextBlock Text="{Binding VideoId}" FontWeight="Bold"/><TextBlock Text="{Binding CreatedAt, Converter={StaticResource SeoulTime}}" FontSize="11" Foreground="#AFBCD5"/><TextBlock Text="{Binding ProfileId, StringFormat='프로필: {0}'}" FontSize="11"/><TextBlock Text="{Binding Status}" Foreground="#9BB7FF"/><TextBlock Text="{Binding Account}"/><TextBlock Text="{Binding CommentText}" MaxHeight="75"/><TextBlock Text="{Binding ErrorMessage}" Foreground="#E5BE7A"/><TextBlock><Hyperlink NavigateUri="{Binding CommentUrl}" RequestNavigate="OpenCommentLink" Foreground="#8EABFF">댓글 보기</Hyperlink></TextBlock><TextBox Text="{Binding CommentUrl, Mode=OneWay}" IsReadOnly="True"/><TextBlock Text="{Binding ScreenshotPath}" FontSize="10"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></ScrollViewer></Border>
   </Grid></TabItem>
   <TabItem Header="⚙  설정"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="760" HorizontalAlignment="Stretch" Margin="36"><TextBlock Text="설정 및 보안" Style="{StaticResource Heading}"/><TextBlock Text="API 키는 Windows 사용자 계정에 연결된 DPAPI로 암호화합니다. 빈 입력은 기존 키를 유지합니다." Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding YouTubeConfigured, StringFormat='YouTube API Key 저장됨: {0}'}"/><PasswordBox x:Name="YouTubeKey"/><TextBlock Text="{Binding GeminiConfigured, StringFormat='Gemini API Key 저장됨: {0}'}"/><PasswordBox x:Name="GeminiKey"/><TextBlock Text="Gemini 모델"/><TextBox Text="{Binding GeminiModel, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Chrome 실행 경로 (비우면 설치된 Chrome 채널)"/><TextBox Text="{Binding ChromePath, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="하루 게시 시도 상한 (1~10)"/><TextBox Text="{Binding DailyLimit, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="SQLite 데이터베이스 절대 경로"/><TextBox Text="{Binding DatabasePath, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="로그 폴더 절대 경로"/><TextBox Text="{Binding LogPath, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="새 프로필 기본 폴더"/><TextBox Text="{Binding ProfileRoot, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="경로 변경은 재시작 후 적용됩니다. 기존 데이터/프로필은 자동 이동하지 않습니다." Foreground="#E5BE7A"/><Button Content="API 키 및 설정 저장" Click="SaveSettings_Click" IsEnabled="{Binding CanWork}"/><TextBlock Text="Chrome 프로필 관리" Style="{StaticResource Heading}" Margin="0,30,0,10"/><ComboBox ItemsSource="{Binding Profiles}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedProfile}" IsEnabled="{Binding CanWork}"/><TextBox Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}"/><TextBox Text="{Binding ProfileDataPath, UpdateSourceTrigger=PropertyChanged}"/><Button Content="프로필 설정 저장" Command="{Binding SaveProfileCommand}"/></StackPanel></ScrollViewer></TabItem>
   <TabItem Header="≡  활동 기록"><DockPanel Margin="28"><StackPanel DockPanel.Dock="Top"><TextBlock Text="활동 기록" Style="{StaticResource Heading}"/><TextBlock Text="강제 종료로 남은 진행 중 게시도 재게시가 차단됩니다. 결과 미확인은 YouTube에서 직접 확인하세요." Foreground="#E5BE7A"/><Button Content="새로 고침" Command="{Binding RefreshCommand}"/></StackPanel><ListBox ItemsSource="{Binding Logs}"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding CreatedAt, Converter={StaticResource SeoulTime}}" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding Message}"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel></TabItem>
  </TabControl>
 </DockPanel>
</Window>



